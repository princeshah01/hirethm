# =============================================================================
# HireTHM environment variables
#
# Copy this file to `.env` in the repo root and fill in real values.
#
# `docker compose up -d` (using compose.yml) only starts the backing services
# below (Postgres, Redis, RedisInsight, MinIO). The apps themselves
# (apps/api, apps/web) are NOT run via Docker — run them locally with
# `npm run dev` / pm2, in both local dev and on the production EC2 box,
# pointing at these services via the connection variables below.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (primary database)
# Used by: compose.yml `postgres` service + apps/api database connection
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hirethm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hirethm
# Full connection string apps/api can consume directly (e.g. Prisma/TypeORM)
DATABASE_URL=postgresql://hirethm:change-me@localhost:5432/hirethm

# -----------------------------------------------------------------------------
# Redis (cache, queues, sessions)
# Used by: compose.yml `redis` service + apps/api
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379

# -----------------------------------------------------------------------------
# RedisInsight (GUI for inspecting Redis)
# Used by: compose.yml `redisinsight` service
# Open http://localhost:5540 and connect using the REDIS_* values above
# -----------------------------------------------------------------------------
REDISINSIGHT_PORT=5540

# -----------------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# Used by: compose.yml `minio` service + apps/api file uploads
# Console UI: http://localhost:9001, API endpoint: http://localhost:9000
# -----------------------------------------------------------------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=hirethm
MINIO_ROOT_PASSWORD=change-me-min-8-chars
# S3 client config apps/api can consume directly (aws-sdk / @aws-sdk/client-s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=hirethm
S3_SECRET_ACCESS_KEY=change-me-min-8-chars
S3_BUCKET=hirethm
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# apps/api (NestJS)
# -----------------------------------------------------------------------------
API_PORT=4000
NODE_ENV=development

# -----------------------------------------------------------------------------
# apps/web (Next.js)
# -----------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
