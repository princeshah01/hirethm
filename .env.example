# -----------------------------------------------------------------------------
# Postgres Variables
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hirethm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hirethm
# Full connection string apps/api can consume directly (e.g. Drizzle)
DATABASE_URL=postgresql://hirethm:change-me@localhost:5432/hirethm

# -----------------------------------------------------------------------------
# Redis Variables
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379

# -----------------------------------------------------------------------------
# RedisInsight Variables
# -----------------------------------------------------------------------------
REDISINSIGHT_PORT=5540

# -----------------------------------------------------------------------------
# MinIO Variables
# -----------------------------------------------------------------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=hirethm
MINIO_ROOT_PASSWORD=change-me-min-8-chars
# S3 client config apps/api can consume directly (@aws-sdk/client-s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=hirethm
S3_SECRET_ACCESS_KEY=change-me-min-8-chars
S3_BUCKET=hirethm
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# API Variables
# -----------------------------------------------------------------------------
API_PORT=4000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Web Variables
# -----------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000