{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "env-cmd -f ../../.env nest start --watch",
    "start": "env-cmd -f ../../.env node dist/main",
    "start:debug": "env-cmd -f ../../.env nest start --debug --watch",
    "check-types": "tsc --noEmit",
    "lint": "biome lint .",
    "db:generate": "env-cmd -f ../../.env drizzle-kit generate",
    "db:migrate": "env-cmd -f ../../.env drizzle-kit migrate",
    "db:push": "env-cmd -f ../../.env drizzle-kit push",
    "db:studio": "env-cmd -f ../../.env drizzle-kit studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@repo/env": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "26.3.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.0"
  }
}
